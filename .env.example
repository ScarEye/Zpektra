# Copy this file to ".env" and fill in your values.
# Register an app at https://developer.spotify.com/dashboard
# In the app settings, add this Redirect URI exactly:
#   http://127.0.0.1:8888/auth/callback
# NOTE: Spotify no longer accepts "localhost" — you must use the loopback IP
# 127.0.0.1. Open the app in your browser at http://127.0.0.1:5173 too.

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Where Spotify sends the user back after consent (must match the dashboard).
REDIRECT_URI=http://127.0.0.1:8888/auth/callback

# Backend port (the Express server).
PORT=8888

# Where the Vite frontend runs (used for redirects after auth).
CLIENT_ORIGIN=http://127.0.0.1:5173
